# Sao chép file này thành `.env.local` rồi điền giá trị từ Firebase Console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
#
# Lưu ý: biến có tiền tố NEXT_PUBLIC_ sẽ được nhúng vào bundle phía trình duyệt.
# Firebase web config vốn là thông tin công khai; dữ liệu được bảo vệ bằng
# Firestore Security Rules và giới hạn API key theo domain, không phải bằng việc giấu key.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Đường dẫn con khi deploy (để trống nếu chạy ở domain gốc). Ví dụ GitHub Pages: /Tocfl
NEXT_PUBLIC_BASE_PATH=

# Azure Translator cho tab Dịch. KHÔNG có tiền tố NEXT_PUBLIC_: key chỉ dùng trong Cloudflare Worker
# (worker/index.ts), không nhúng vào trình duyệt. Trên Cloudflare đặt 3 biến này cùng FIREBASE_PROJECT_ID
# ở Worker → Settings → Variables and secrets (loại Secret, biến runtime).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Chỉ dùng khi chạy local: `npm run dev` + `npm run dev:worker` (Wrangler đọc file .env.local này).
# Để trống khi build production, client sẽ gọi /api/translate cùng domain.
NEXT_PUBLIC_TRANSLATE_API=

# Cloudflare Turnstile cho màn đăng nhập (Cloudflare Dashboard → Turnstile → Add widget, thêm hostname
# localhost và domain *.workers.dev). Site key là công khai: trên Cloudflare đặt ở Settings → Build →
# Variables and secrets (biến lúc build). Secret key đặt ở Worker → Settings → Variables and secrets (Secret).
# Để trống site key thì màn đăng nhập bỏ qua bước xác minh.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
